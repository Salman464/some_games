<% content_for :title, "Games" %>

<% if notice.present? %>
  <p class="flash flash--notice"><%= notice %></p>
<% end %>

<section class="browse">
  <div class="container">
    <h1 class="visually-hidden">Browse games</h1>
    <div class="games-grid">
      <%= render @games %>
    </div>
  </div>
</section>
