<% if notice.present? %>
  <p class="flash flash--notice"><%= notice %></p>
<% end %>

<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-lg-4">
      <%= render @game, linked: false %>

      <div class="d-flex flex-wrap gap-2 mt-4">
        <%= link_to "Edit this game", edit_game_path(@game), class: "btn btn-primary" %>
        <%= link_to "Back to games", games_path, class: "btn btn-outline-secondary" %>
        <%= button_to "Destroy this game", @game, method: :delete, class: "btn btn-outline-danger" %>
      </div>
    </div>
  </div>
</section>
